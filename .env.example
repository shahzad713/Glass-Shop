# Labbyak Glass & Aluminium — environment variables
# Copy to `.env.local` for local dev. NEVER commit real secrets.
# On Vercel, add these under Project Settings → Environment Variables.

# --- Contact form email (server-side only — Resend) ---
# Get an API key at https://resend.com. This key is SERVER-SIDE ONLY and must
# NOT be prefixed with VITE_ (that would expose it in the browser bundle).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact-form leads.
CONTACT_TO_EMAIL=asifmunir062@gmail.com

# Verified sender. Until your domain is verified in Resend, use the Resend
# shared sender: onboarding@resend.dev
# After verifying labbyakglass.com in Resend, switch to e.g.
# website@labbyakglass.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# --- Public site config (safe to expose; VITE_ prefix = bundled) ---
VITE_SITE_URL=https://www.labbyakglass.com

# Optional: Google Analytics 4. Leave blank to disable analytics entirely.
VITE_GA_MEASUREMENT_ID=
